# Copie para deploy/.env.prod (fora do git) e preencha. Gere senhas com: openssl rand -hex 24 (hex: a senha entra numa URL)
POSTGRES_PASSWORD=
# E-mail para o Let's Encrypt (avisos de expiração)
ACME_EMAIL=
# Webhook que recebe os alertas de falha do ETL (Slack/Discord/Mattermost). Vazio = só log.
ALERT_WEBHOOK_URL=
# Intervalo do job diário (padrão 2h)
DAILY_EVERY=2h
# Endereço público do site (links de compartilhamento e imagens de pré-visualização)
SITE_URL=https://www.comovotacongresso.com.br
